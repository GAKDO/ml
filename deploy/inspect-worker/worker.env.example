# inspect-worker(집 PC) 환경 변수 형식. 값은 넣지 않는다. 복사해 worker.env로 쓰고 커밋하지 않는다.
# 이름은 gitops infra.env·trace-secrets와 같다.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/trace
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# 서비스 사진(trace-captures)과 결과(trace-derived)가 있는 MinIO S3 API 주소
MINIO_ENDPOINT=
# trace-worker 역할 키(없으면 MINIO_ACCESS_KEY·MINIO_SECRET_KEY)
WORKER_MINIO_ACCESS_KEY=
WORKER_MINIO_SECRET_KEY=
TRACE_CAPTURES_BUCKET=trace-captures
TRACE_DERIVED_BUCKET=trace-derived
# 기본 기종: 이벤트에 device(기종·치수)가 없을 때만 씀(워커 기종 표에 있어야 함)
TRACE_DEVICE_MODEL=MBA13-M2
# 폰 흠집 탐지 가중치(부스와 같은 학습 결과 trace-models/<버전>/<실행>/best.pt). 같은 폴더에 model.json(modelVersion·classes)
# 비우면 폰 탐지를 건너뛴다(detector-pending)
TRACE_DETECT_WEIGHTS=
# 정합: contour(기본, 윤곽 4점) | features(윤곽 + 같은 대여 첫 시점 이미지에 특징점 보정)
# features일 때 TRACE_MODEL_DIR에 superpoint.onnx·lightglue.onnx가 있으면 SuperPoint+LightGlue, 없으면 ORB
TRACE_ALIGN=contour
# 진행률(선택). 없으면 진행률 없이 처리한다
REDIS_HOST=
REDIS_PORT=6379
REDIS_DATABASE=2
REDIS_PASSWORD=
REDIS_KEY_PREFIX=trace:
