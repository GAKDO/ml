{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawAndLabels",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::trace-raw", "arn:aws:s3:::trace-raw/*",
        "arn:aws:s3:::trace-labels", "arn:aws:s3:::trace-labels/*"
      ]
    },
    {
      "Sid": "WriteDatasetsAndModelsNoDelete",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::trace-datasets", "arn:aws:s3:::trace-datasets/*",
        "arn:aws:s3:::trace-models", "arn:aws:s3:::trace-models/*"
      ]
    }
  ]
}
